    {
      "oracle_id": "ISA-G01",
      "operation": "scalar",
      "function": "isa_scalar",
      "inputs": {
        "left": "L",
        "right": "R"
      },
      "expected_relations": [
        "return == (L + R) xor 0x013579bd modulo 32 bits"
      ],
      "forbidden_relations": [
        "return is unconstrained"
      ]
    },
    {
      "oracle_id": "ISA-G02",
      "operation": "branch",
      "function": "isa_branch",
      "inputs": {
        "value": "V",
        "selector": "S"
      },
      "expected_relations": [
        "S != 0 selects V + 3",
        "S == 0 selects V xor 5"
      ],
      "forbidden_relations": [
        "both branch results hold simultaneously"
      ]
    },
    {
      "oracle_id": "ISA-G03",
      "operation": "load",
      "function": "isa_load",
      "inputs": {
        "slot.memory[0,4)": "M"
      },
      "expected_relations": [
        "return has label/value M from slot.memory[0,4)"
      ],
      "forbidden_relations": [
        "load reads beyond four bytes"
      ]
    },
    {
      "oracle_id": "ISA-G04",
      "operation": "store",
      "function": "isa_store",
      "inputs": {
        "value": "V"
      },
      "expected_relations": [
        "slot.memory[0,4) becomes V"
      ],
      "forbidden_relations": [
        "store writes beyond four bytes"
      ]
    },
    {
      "oracle_id": "ISA-G05",
      "operation": "call",
      "function": "isa_call",
      "inputs": {
        "value": "V"
      },
      "expected_relations": [
        "return composes through isa_scalar(V, 7)"
      ],
      "forbidden_relations": [
        "callee effects are silently discarded"
      ]
    }
  ],
